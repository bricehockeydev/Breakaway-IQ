// Prisma schema for the hockey skills app.
// Dev uses SQLite; switch `provider` to "postgresql" and update DATABASE_URL for deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  analyses     Analysis[]
}

// --- Auth.js (NextAuth) adapter tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App tables ---

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  status               String    @default("inactive") // inactive | active | trialing | past_due | canceled
  plan                 String    @default("monthly")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Analysis {
  id               String   @id @default(cuid())
  userId           String
  skillKey         String
  videoUrl         String
  videoDurationSec Float?
  trimStartSec     Float?
  trimEndSec       Float?
  status           String   @default("draft") // draft | processing | complete | failed
  resultJson       String?  // JSON-serialized AnalysisResult
  errorMessage     String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
