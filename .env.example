# Copy to .env.local (Next.js loads it automatically) and fill in real values.

# --- Database ---
# SQLite for local dev. For production use Postgres, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/skillsapp"
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# --- Anthropic (video analysis) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Vercel Blob (video storage) ---
# Create a Blob store in the Vercel dashboard -> Storage, then copy the token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
