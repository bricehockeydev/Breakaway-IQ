# Copy to .env.local (Next.js loads it automatically) and fill in real values.

# --- Database ---
# SQLite for local dev. For production use Postgres, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/skillsapp"
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# --- Anthropic (video analysis) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Vercel Blob (video storage) ---
# OPTIONAL for local dev: if this is unset, uploads are saved to ./uploads on disk
# and served via /api/uploads. Set it (and deploy) to store videos in Vercel Blob:
# Vercel dashboard -> Storage tab -> Create -> Blob -> copy the RW token.
BLOB_READ_WRITE_TOKEN=""

# --- Stripe (billing) ---
# OPTIONAL for local dev: if these are unset, the "Start membership" button is a
# no-payment stub. Set all three to switch on real Stripe Checkout.
# 1. Stripe dashboard (Test mode) -> Developers -> API keys -> Secret key:
STRIPE_SECRET_KEY=""
# 2. Run:  node --env-file=.env.local scripts/setup-stripe.ts   -> prints this:
STRIPE_PRICE_ID=""
# 3. Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints it.
#    Prod: Stripe dashboard -> Developers -> Webhooks -> add endpoint -> signing secret.
STRIPE_WEBHOOK_SECRET=""
# Optional: force the base URL used for Stripe redirects (else derived from the request)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
